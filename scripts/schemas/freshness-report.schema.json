{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up freshness report",
  "type": "object",
  "required": ["repositories"],
  "properties": {
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "days", "date", "state"],
        "properties": {
          "path": { "type": "string" },
          "days": { "type": ["integer", "string"] },
          "date": { "type": "string" },
          "state": { "enum": ["fresh", "stale", "missing"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
