{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up native workflow report",
  "type": "object",
  "required": ["repositories"],
  "properties": {
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "state"],
        "properties": {
          "path": { "type": "string" },
          "state": { "enum": ["native-workflow", "missing-native-workflow"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
