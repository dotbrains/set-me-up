{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up sync report",
  "type": "object",
  "required": ["repositories"],
  "properties": {
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "state", "sync", "validator"],
        "properties": {
          "path": { "type": "string" },
          "state": { "enum": ["clean", "dirty", "changed", "detached", "missing", "not-git"] },
          "sync": { "type": "string" },
          "validator": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
