{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up agent intake report",
  "type": "object",
  "required": [
    "query",
    "matchedIntents",
    "riskSummary",
    "ambiguities",
    "repositories",
    "nextCommands"
  ],
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string" },
    "matchedIntents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "riskSummary": {
      "type": "object",
      "required": ["high", "medium", "low", "blocking", "reasons"],
      "additionalProperties": false,
      "properties": {
        "high": { "type": "integer" },
        "medium": { "type": "integer" },
        "low": { "type": "integer" },
        "blocking": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intent", "confidence", "score"],
        "additionalProperties": false,
        "properties": {
          "intent": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high"] },
          "score": { "type": "integer" }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "confidence",
          "score",
          "risk",
          "source",
          "explanation",
          "repo",
          "route",
          "summary",
          "keywords",
          "state",
          "sync",
          "validator",
          "docs",
          "warnings",
          "risks"
        ],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "related"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "score": { "type": "integer" },
          "risk": { "type": "string", "enum": ["high", "medium", "low"] },
          "source": { "type": "string" },
          "explanation": { "type": "string" },
          "repo": { "type": "string" },
          "route": { "type": "string" },
          "summary": { "type": "string" },
          "keywords": { "type": "string" },
          "state": { "type": "string" },
          "sync": { "type": "string" },
          "validator": { "type": "string" },
          "docs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "nextCommands": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
